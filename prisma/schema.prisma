model NewsletterSubscriber {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("newsletter_subscribers")
}

model MiniCombo {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(300)
  nameI18n    Json?           @map("name_i18n")
  description String?
  price       Decimal         @db.Decimal(10, 2)
  oldPrice    Decimal?        @map("old_price") @db.Decimal(10, 2)
  imageUrl    String          @map("image_url")
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  cartItems   CartItem[]
  items       MiniComboItem[]
  orderItems  OrderItem[]

  @@map("mini_combos")
}

model MiniComboItem {
  id          String    @id @default(uuid()) @db.Uuid
  miniComboId String    @map("mini_combo_id") @db.Uuid
  menuItemId  String    @map("menu_item_id") @db.Uuid
  quantity    Int       @default(1) @db.SmallInt
  sortOrder   Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  miniCombo   MiniCombo @relation(fields: [miniComboId], references: [id], onDelete: Cascade)
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("mini_combo_items")
}
